# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (backend — set in Netlify dashboard, not here)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (backend — set in Netlify dashboard)
# ANTHROPIC_API_KEY=

# Extra browser origins allowed to call the API (comma-separated). The site's own
# URL / DEPLOY_PRIME_URL are always allowed automatically; set this only if the
# frontend is served from an additional custom domain.
# ALLOWED_ORIGINS=https://puntingclub.app,https://www.puntingclub.app

# Admin panel passwords (server-side only — NOT prefixed with VITE_, never bundled into JS)
# These are validated in netlify/functions/auth.js
ADMIN_PW_OWNER=change-me-owner
ADMIN_PW_CM=change-me-cm
ADMIN_PW_PUB=change-me-pub

# Secret used to sign admin session tokens — generate with:
# node -e "require('crypto').randomBytes(32, (_,b)=>console.log(b.toString('hex')))"
ADMIN_JWT_SECRET=change-me-generate-a-random-hex-string

# Google / Apple sign-in (frontend — these are PUBLIC values and are bundled into the app).
# Only safe once Row Level Security is on for every table
# (supabase/migrations/20261108020000_lock_down_rls.sql). Leave unset to hide the buttons.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon / publishable key>
# VITE_AUTH_PROVIDERS=google,apple
